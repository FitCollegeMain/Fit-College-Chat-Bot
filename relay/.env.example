# Copy to .env and fill in. Only ANTHROPIC_API_KEY is required.

# Required — server refuses to start without it
ANTHROPIC_API_KEY=

# Optional — name personalisation + CRM write-back (fails safe if unset)
HUBSPOT_TOKEN=

# Optional — shared secret for POST /admin/reload-kb
ADMIN_RELOAD_TOKEN=

# Optional — overrides (defaults shown)
ALLOWED_ORIGIN=https://www.fitcollege.edu.au
CHAT_MODEL=claude-haiku-4-5-20251001
SUMMARY_MODEL=claude-haiku-4-5-20251001
PORT=3000
