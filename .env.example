# FIT College Career Advisor relay — environment configuration.
# Copy to .env (which is gitignored) and fill in real values.

# REQUIRED — the server refuses to start without this.
ANTHROPIC_API_KEY=sk-ant-...

# Browser origin allowed to call the relay (the site the widget lives on).
# Must match exactly, including scheme. No trailing slash.
ALLOWED_ORIGIN=https://www.fitcollege.edu.au

# Optional — HubSpot private-app token (crm scopes). Without it the chat still
# works; name personalisation and CRM write-back are simply skipped.
HUBSPOT_TOKEN=pat-...

# Optional — shared secret for POST /admin/reload-kb (reload the KB without a
# restart). If unset, that endpoint always returns 403.
ADMIN_RELOAD_TOKEN=

# Optional — models (sensible defaults are baked in).
CHAT_MODEL=claude-haiku-4-5-20251001
SUMMARY_MODEL=claude-haiku-4-5-20251001

# Optional — port (default 3000).
PORT=3000
